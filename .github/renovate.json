{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "schedule": ["* 0-9 1-7,15-21,29-31 * 1"],
  "timezone": "America/New_York",
  "updateNotScheduled": true,
  "commitMessageSuffix": "({{{baseBranch}}})",
  "kustomize": {
    "enabled": false
  },
  "dockerfile": {
    "managerFilePatterns": ["build/*Dockerfile.rhtap"],
    "ignorePaths": ["**/Dockerfile"]
  },
  "gomod": {
    "packageRules": [
      {
        "matchDepTypes": ["indirect"],
        "enabled": false
      }
    ]
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "commitMessageSuffix": "[SECURITY] ({{{baseBranch}}})"
  },
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub actions"
    },
    {
      "groupName": "Bundle containerfile images",
      "matchManagers": ["dockerfile"],
      "ignorePaths": ["**/bundle.Dockerfile.rhtap"],
      "pinDigests": true
    },
    {
      "groupName": "Containerfile images",
      "matchManagers": ["dockerfile"],
      "ignorePaths": ["**/Dockerfile.rhtap"],
      "pinDigests": false
    },
    {
      "matchManagers": ["gomod"],
      "enabled": false
    }
  ]
}
